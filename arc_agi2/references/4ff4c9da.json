le. So only L-shaped 2-components with exactly the same orientation will be recoloured to 8.","code":"def transform(grid):\n    g = np.array(grid)\n    out = g.copy()\n    H, W = g.shape\n    MARK = 8\n    m = g == MARK\n    clean_rows = [y for y in range(H) if not m[y].any()]\n    clean_cols = [x for x in range(W) if not m[:, x].any()]\n\n    def underlying(y, x):\n        if H == W and g[x, y] != MARK:\n            return int(g[x, y])\n        ok = ~m[y]\n        for y2 in clean_rows:\n            if (g[y2][ok] == g[y][ok]).all():\n                return int(g[y2, x])\n        ok = ~m[:, x]\n        for x2 in clean_cols:\n            if (g[:, x2][ok] == g[:, x][ok]).all():\n                return int(g[y, x2])\n        return None\n\n    def shape_of(cells):\n        y0, x0, y1, x1 = bbox(cells)\n        s = np.zeros((y1 - y0 + 1, x1 - x0 + 1), dtype=bool)\n        for y, x in cells:\n            s[y - y0, x - x0] = True\n        return s\n\n    for comp in components(m, diagonal=True):\n        t = shape_of(comp)\n        vals = [underlying(y, x) for y, x in comp]\n        vals = [v for v in vals if v is not None]\n        if vals:\n            cols = [Counter(vals).most_common(1)[0][0]]\n        else:\n            cols = [c for c in np.unique(g) if c != MARK]\n        changed = False\n        for c in cols:\n            for cc in components(g == c, diagonal=True):\n                s = shape_of(cc)\n                if s.shape == t.shape and (s == t).all():\n                    for y, x in cc:\n                        out[y, x] = MARK\n                    changed = True\n        if changed:\n            emit(out.copy(), \"Recolour every object of the hidden colour that has exactly this 8-template's shape to 8.\")\n\n    emit(out.copy(), \"Final grid: all objects matching an 8-template are marked with 8.\")\n    return out\n\nfrom collections import Counter\n","candidate_tactics":{"recolour":[{"source":"final explanation","text":"My code recoloured every same-shaped component of *any* colour, so the isolated 0-0 dominoes at rows 0–1, 6, 10 and 12–13 were wrongly turned 8."},{"source":"final explanation","text":"So only L-shaped 2-components with exactly the same orientation will be recoloured to 8."},{"source":"verified program checkpoint","text":"Recolour every object of the hidden colour that has exactly this 8-template's shape to 8."}],"rigid":[{"source":"final explanation","text":"Every grid is transpose-symmetric apart from the 8s, so the mirror cell (x, y) usually shows the hidden value."}],"template":[{"source":"final explanation","text":"The template there is a horizontal or vertical domino of 8s."},{"source":"final explanation","text":"The fix is to learn which colour each 8-template has painted over and match only components of that colour:"},{"source":"verified program checkpoint","text":"Recolour every object of the hidden colour that has exactly this 8-template's shape to 8."}],"count":[{"source":"final explanation","text":"- **Pair 1:** the 8s replaced 2s, so only 2-dominoes count."},{"source":"final explanation","text":"- **Pair 2:** the 8s replaced 1s, so only 1-pluses count."}]},"provenance":{"reference_assisted":false,"query_labels_used_for_rule_diagnosis":false},"artifact_sha256":"b5c78994c9c6a4f9509fd5cbeeab388abddacc38773c0dac33770ac565fb6807","task_sha256":"40b00894337370a81942d62b3bc9c33db994e1dd5dcaeb716aac868f4c0ff53e","validation":"Frozen corpus recorded successful replay on teaching fixtures; synthetic generalization not established."}
