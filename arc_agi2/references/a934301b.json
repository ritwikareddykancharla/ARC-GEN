sform(grid):\n    g = np.array(grid)\n    bg = background(g)\n    out = g.copy()\n    objs = objects(g, bg=bg, multicolour=True)\n    for o in objs:\n        n8 = sum(1 for (y, x) in o[\"cells\"] if g[y, x] == 8)\n        if n8 >= 2:\n            for (y, x) in o[\"cells\"]:\n                out[y, x] = bg\n            emit(out, f\"Erase block at {o['box']}: it contains {n8} cells of colour 8 (two or more).\")\n    emit(out, \"Final: only blocks with at most one 8 remain.\")\n    return out\n","candidate_tactics":{"objects":[{"source":"final explanation","text":"If I treat each block as one multicolour object (1 and 8 together, 4‑connected), a simple pattern shows up:"}]},"provenance":{"reference_assisted":false,"query_labels_used_for_rule_diagnosis":false},"artifact_sha256":"d2725ced890f5ce23cb63163ecaa1726ffc14d2064dd892e03c9410db78c81a9","task_sha256":"15a453671d420f2451dddb42af67bd604e19e5c6cab3bafe6d0fee2bb53901f1","validation":"Frozen corpus recorded successful replay on teaching fixtures; synthetic generalization not established."}
