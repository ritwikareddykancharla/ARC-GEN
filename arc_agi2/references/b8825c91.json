3,9,7,3,9,5,5],[6,5,1,9,7,7,3,3,3,3,7,7,9,1,5,6],[9,1,5,5,6,1,7,9,9,7,1,6,5,5,1,9],[9,9,6,5,9,6,7,7,7,7,6,9,5,6,9,9]]}],"test":[{"input":[[7,7,8,1,9,8,2,6,6,2,8,9,1,8,7,7],[7,1,1,8,8,8,6,6,6,6,8,8,8,1,1,7],[8,1,6,9,2,6,4,4,4,6,6,2,9,6,1,8],[1,8,9,1,6,6,4,4,4,1,6,6,1,9,8,1],[9,8,2,6,8,7,4,4,4,6,4,4,4,4,8,9],[8,8,6,6,7,7,6,5,5,6,4,4,4,4,8,8],[2,6,6,1,6,6,5,5,5,5,4,4,4,4,6,2],[6,6,1,1,6,5,5,7,7,5,4,4,4,4,6,6],[6,6,1,1,6,5,5,7,7,5,5,6,1,1,6,6],[2,6,6,1,6,6,5,5,5,5,6,6,1,6,6,2],[8,8,6,6,7,7,6,5,5,6,7,7,6,6,8,8],[9,8,2,6,8,7,6,6,6,6,7,8,6,2,8,9],[1,8,9,1,6,6,1,1,1,1,6,6,1,9,8,1],[8,1,6,9,2,6,6,1,1,6,6,2,9,6,1,8],[7,1,1,8,8,8,6,6,6,6,8,8,8,1,1,7],[7,7,8,1,9,8,2,6,6,2,8,9,1,8,7,7]],"output":[[7,7,8,1,9,8,2,6,6,2,8,9,1,8,7,7],[7,1,1,8,8,8,6,6,6,6,8,8,8,1,1,7],[8,1,6,9,2,6,6,1,1,6,6,2,9,6,1,8],[1,8,9,1,6,6,1,1,1,1,6,6,1,9,8,1],[9,8,2,6,8,7,6,6,6,6,7,8,6,2,8,9],[8,8,6,6,7,7,6,5,5,6,7,7,6,6,8,8],[2,6,6,1,6,6,5,5,5,5,6,6,1,6,6,2],[6,6,1,1,6,5,5,7,7,5,5,6,1,1,6,6],[6,6,1,1,6,5,5,7,7,5,5,6,1,1,6,6],[2,6,6,1,6,6,5,5,5,5,6,6,1,6,6,2],[8,8,6,6,7,7,6,5,5,6,7,7,6,6,8,8],[9,8,2,6,8,7,6,6,6,6,7,8,6,2,8,9],[1,8,9,1,6,6,1,1,1,1,6,6,1,9,8,1],[8,1,6,9,2,6,6,1,1,6,6,2,9,6,1,8],[7,1,1,8,8,8,6,6,6,6,8,8,8,1,1,7],[7,7,8,1,9,8,2,6,6,2,8,9,1,8,7,7]]}]},"teaching_variant":"canonical","teacher_models":["claude-opus-5-5"],"explanation":"The demonstrations show a grid with a strong repeating mirror pattern, and some patches painted over with a \"paint\" colour that has to be removed.\n\n**What the grids are made of.** Every grid is 16×16 and is symmetric in several ways at once. Cell (y, x) matches its left–right mirror (y, 15−x). It also matches its up–down mirror (15−y, x) and its transpose (x, y). Combining these gives up to 7 partner cells that should hold the same colour. The fact sheet confirms this symmetry for pair 2: about 87% of cells already match, and every cell that breaks it belongs to a colour‑4 patch or sits where a patch is.\n\n**What changes.** In all four pairs, colour 4 appears only in the input. Every changed cell is a 4 that becomes some other colour. Spot checks agree with the symmetry:\n- Pair 1, the patch at rows 11–14, columns 2–5: its top‑left cell (11, 2) becomes 7. Its vertical mirror (4, 2) is 7.\n- Pair 3, the patch at rows 1–3, columns 10–13: cell (1, 10) becomes 5. Its horizontal mirror (1, 5) is 5.\n\nSo the 4s are a mask over a perfectly symmetric picture. Each masked cell can be restored by copying any of its symmetric partners that is not masked.\n\n**Rule.**\n1. Treat the mask colour 4 as unknown. The fact sheet shows it is the masking colour in every pair, and it is still 4 in the test.\n2. For each masked cell, try the partners (y, n−1−x), (n−1−y, x), (n−1−y, n−1−x), (x, y), (x, n−1−y), (n−1−x, y), (n−1−x, n−1−y). Copy the first one that is not masked.\n3. Repeat until nothing changes. This covers the case where a cell's only partners are themselves masked at first.\n\n**Teaching stages.** Each connected 4‑patch is repaired as one stage, and its restored canvas is emitted. After all patches are done, the final canvas is emitted again.\n\n**Test.** The test has two 4‑patches:\n- a 4×4 block at rows 4–7, columns 10–13;\n- an irregular 9‑cell blob around rows 2–4, columns 6–8.\n\nBoth are restored from their mirror partners in the same way.","code":"def transform(grid):\n    g = np.array(grid).copy()\n    n, m = g.shape\n    MASK = 4\n    masked = (g == MASK)\n    known = ~masked\n\n    def partners(y, x):\n        c = [(y, m-1-x), (n-1-y, x), (n-1-y, m-1-x)]\n        if n == m:\n            c += [(x, y), (x, n-1-y), (m-1-x, y), (m-1-x, n-1-y)]\n        return c\n\n    comps = components(masked)\n    for comp in comps:\n        remaining = list(comp)\n        while remaining:\n            progress = False\n            rest = []\n            for (y, x) in remaining:\n                for (py, px) in partners(y, x):\n                    if 0 <= py < n and 0 <= px < m and known[py, px]:\n                        g[y, x] = g[py, px]\n                        known[y, x] = True\n                        progress = True\n                        break\n                else:\n                    rest.append((y, x))\n            remaining = rest\n            if not progress:\n                break\n        emit(g.copy(), f\"Restore the masked patch at {bbox(comp)} by copying each cell from its mirror/transpose partner.\")\n    emit(g.copy(), \"All masked patches repaired; the grid is fully symmetric again.\")\n    return g\n","candidate_tactics":{"rigid":[{"source":"final explanation","text":"The demonstrations show a grid with a strong repeating mirror pattern, and some patches painted over with a \"paint\" colour that has to be removed."},{"source":"final explanation","text":"**What the grids are made of.** Every grid is 16×16 and is symmetric in several ways at once."},{"source":"final explanation","text":"Cell (y, x) matches its left–right mirror (y, 15−x)."}],"repair":[{"source":"final explanation","text":"Each masked cell can be restored by copying any of its symmetric partners that is not masked."},{"source":"final explanation","text":"**Teaching stages.** Each connected 4‑patch is repaired as one stage, and its restored canvas is emitted."},{"source":"final explanation","text":"Both are restored from their mirror partners in the same way."}]},"provenance":{"reference_assisted":false,"query_labels_used_for_rule_diagnosis":false},"artifact_sha256":"c898a6ca4bc5340dceb2eb356c851a93ac3460300224a92d7e2a3642fc4e4c6f","task_sha256":"a6674a7f38ba2d7ec6f77d361ebaa0baf897ac35bc26f72e832e6e114ee3788c","validation":"Frozen corpus recorded successful replay on teaching fixtures; synthetic generalization not established."}
