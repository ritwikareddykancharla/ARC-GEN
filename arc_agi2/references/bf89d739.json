er four dots each get a vertical branch:\n- (3,6) fills rows 4–7 of column 6.\n- (6,4) fills row 7 of column 4.\n- (10,10) fills row 9 of column 10.\n- (12,8) fills rows 9–11 of column 8.","code":"def transform(grid):\n    import itertools\n    g = np.array(grid).copy()\n    bg = background(g)\n    pts = [(int(y), int(x)) for y, x in zip(*np.nonzero(g != bg))]\n    col = 3\n    spine = None\n    for a, b in itertools.combinations(pts, 2):\n        if a[0] == b[0]:\n            spine = ('row', a[0], min(a[1], b[1]), max(a[1], b[1]), a, b)\n            break\n        if a[1] == b[1]:\n            spine = ('col', a[1], min(a[0], b[0]), max(a[0], b[0]), a, b)\n            break\n    if spine is None:\n        emit(g, \"No aligned pair of dots; nothing to draw.\")\n        return g\n    kind, line, lo, hi, a, b = spine\n    if kind == 'row':\n        g[line, lo + 1:hi] = col\n    else:\n        g[lo + 1:hi, line] = col\n    emit(g, f\"Connect the two dots sharing {kind} {line} with a green spine.\")\n    for (y, x) in pts:\n        if (y, x) in (a, b):\n            continue\n        if kind == 'row':\n            y0, y1 = sorted((y, line))\n            g[y0 + 1:y1, x] = col\n        else:\n            x0, x1 = sorted((x, line))\n            g[y, x0 + 1:x1] = col\n        emit(g, f\"Draw a perpendicular branch from dot ({y},{x}) to the spine.\")\n    emit(g, \"Final: spine plus all branches.\")\n    return g\n","candidate_tactics":{"paths":[{"source":"verified program checkpoint","text":"Connect the two dots sharing row 9 with a green spine."},{"source":"verified program checkpoint","text":"Connect the two dots sharing col 5 with a green spine."},{"source":"verified program checkpoint","text":"Connect the two dots sharing col 4 with a green spine."}]},"provenance":{"reference_assisted":false,"query_labels_used_for_rule_diagnosis":false},"artifact_sha256":"7cfe65af73a18b383337e4b94dab0b1801f13d77420bbcd34c0bbb0692701e38","task_sha256":"5d899ba7905e25622f3e22aca5b8757e6c40e