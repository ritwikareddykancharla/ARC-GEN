n- A narrower glyph gets the slot whose 3-cell span contains it.\n\nThe line-alignment test also compares these snapped positions. Nothing else changes.\n\n**Effect on the tests.**\n- **Test 1:** the matches are the 0, 1, 9 and 2-ring glyphs in slot column x=17. That is a success, so the column is framed and the top band and bottom band turn 3.\n- **Test 2:** the matches are in scattered slots, so it is a failure. The four slots get frames and the bottom band turns 2.","code":"def transform(grid):\n    g = np.array(grid)\n    out = g.copy()\n    bg = background(g)\n    H, W = g.shape\n    div = sorted(y for y, c in dividers(g)[\"rows\"])\n    d1, d2 = div[0], div[-1]\n\n    def glyphs(y0, y1):\n        res = []\n        for o in objects(g[y0:y1], bg=bg, diagonal=True):\n            by0, bx0, by1, bx1 = o[\"box\"]\n            res.append(((by0 + y0, bx0, by1 + y0, bx1), o[\"grid\"]))\n        return res\n\n    top = glyphs(0, d1)\n    mid = glyphs(d1 + 1, d2)\n\n    # slot grid: starts of full-size (3-wide / 3-tall) glyphs\n    size = max(max(b[2] - b[0], b[3] - b[1]) + 1 for b, _ in mid)\n    xs = sorted(set(b[1] for b, _ in mid if b[3] - b[1] + 1 == size))\n    ys = sorted(set(b[0] for b, _ in mid if b[2] - b[0] + 1 == size))\n\n    def snap(v0, v1, starts):\n        for s in starts:\n            if s <= v0 and v1 <= s + size - 1:\n                return s\n        return v0\n\n    matches = []\n    for tb, tg in top:\n        for mb, mg in mid:\n            if mg.shape == tg.shape and np.array_equal(mg, tg):\n                sy = snap(mb[0], mb[2], ys)\n                sx = snap(mb[1], mb[3], xs)\n                matches.append((sy, sx, sy + size - 1, sx + size - 1))\n                break\n\n    for (y0, x0, y1, x1) in matches:\n        for y in range(max(y0 - 1, 0), min(y1 + 2, H)):\n            for x in range(max(x0 - 1, 0), min(x1 + 2, W)):\n                if out[y, x] == bg:\n                    out[y, x] = 3\n        emit(out, f\"Frame the catalogue slot {(y0, x0, y1, x1)} holding a top glyph with colour 3.\")\n\n    success = (len(matches) == len(top) and len(matches) > 1 and\n               (len(set(m[0] for m in matches)) == 1 or len(set(m[1] for m in matches)) == 1))\n\n    if success:\n        out[d2 + 1:, :][out[d2 + 1:, :] == bg] = 3\n        emit(out, \"All glyphs were found in one row/column: fill the bottom band with 3.\")\n        out[:d1, :][out[:d1, :] == bg] = 3\n        emit(out, \"Success also turns the top band's background to 3.\")\n    else:\n        out[d2 + 1:, :][out[d2 + 1:, :] == bg] = 2\n        emit(out, \"The glyphs are not aligned in one line: fill the bottom band with 2.\")\n    emit(out, \"Final grid.\")\n    return out\n","candidate_tactics":{"legend":[{"source":"final explanation","text":"That is the frame around the catalogue glyph of colour 6 at (13–15, 13–14)."},{"source":"final explanation","text":"That glyph is only 2 cells wide, so the frame was built from its tight bounding box, x=13..14."},{"source":"final explanation","text":"But the glyphs sit in a regular grid of 3×3 slots."}],"movement":[{"source":"final explanation","text":"The line-alignment test also compares these snapped positions."}],"crop":[{"source":"final explanation","text":"That glyph is only 2 cells wide, so the frame was built from its tight bounding box, x=13..14."}],"instructions":[{"source":"final explanation","text":"That is the frame around the catalogue glyph of colour 6 at (13–15, 13–14)."},{"source":"final explanation","text":"That glyph is only 2 cells wide, so the frame was built from its tight bounding box, x=13..14."},{"source":"final explanation","text":"But the glyphs sit in a regular grid of 3×3 slots."}]},"provenance":{"reference_assisted":false,"query_labels_used_for_rule_diagnosis":false},"artifact_sha256":"ad9bd2f053383dcc19d5146efd53f07d60a075f948977ba8ec1d3e044811e6c1","task_sha256":"c42102956657a63074205048eeb14c04e341f1c86c18d6da4712bfd3378ddf25","validation":"Frozen corpus recorded succes