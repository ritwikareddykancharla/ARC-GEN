    ys, xs = np.nonzero(g != bg)\n    if len(ys) == 0:\n        emit(out, \"No shapes; nothing to split.\")\n        return out\n    y0, y1, x0, x1 = ys.min(), ys.max(), xs.min(), xs.max()\n    for y in range(y0, y1 + 1):\n        if np.all(g[y] == bg):\n            out[y, :] = 3\n            emit(out, f\"Row {y} is an empty gap between the two halves: draw a full colour-3 line across it.\")\n    for x in range(x0, x1 + 1):\n        if np.all(g[:, x] == bg):\n            out[:, x] = 3\n            emit(out, f\"Column {x} is an empty gap between the two halves: draw a full colour-3 line down it.\")\n    emit(out, \"Final grid: the separating line is drawn.\")\n    return out\n","candidate_tactics":{"crop":[{"source":"final explanation","text":"Take the bounding box of all non-background cells."}]},"provenance":{"reference_assisted":false,"query_labels_used_for_rule_diagnosis":false},"artifact_sha256":"588d6ed83d9ab10d97339c1ae420ee8f6d4bcbc2c6b24579eabb2b9dbb7ca7ca","task_sha256":"2bd266fae955bc01a5548f41b933455d3b0820c154d88a0bf4e120fb26f7475d","validation":"Frozen corpus recorded successful replay on teaching fixtures; synthetic generalization not established."}
